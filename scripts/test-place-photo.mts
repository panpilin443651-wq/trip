/**
 * ทดสอบตัวกรองรูปประกอบสถานที่
 *
 * ใช้: node --experimental-strip-types --import ./scripts/alias-hooks.mjs scripts/test-place-photo.mts
 *
 * การค้นของวิกิพีเดียคืนหน้าที่ใกล้เคียงมาเสมอ ไม่เคยตอบว่าไม่เจอ
 * ตัวกรองนี้จึงเป็นด่านเดียวที่กันรูปผิดไม่ให้ไปโผล่หน้าเว็บ
 */
import { isRelevantPage } from "@/lib/place-photo";

let pass = 0;
let fail = 0;
const check = (n: string, c: boolean, e = "") =>
  c ? (pass++, console.log("  ✓ " + n)) : (fail++, console.log("  ✗ " + n + " " + e));

/** [ชื่อสถานที่, ชื่อหน้าที่ค้นเจอ, ควรรับไหม] */
const CASES: Array<[string, string, boolean]> = [
  ["หาดชะอำ", "หาดชะอำ", true],
  ["วัดเขาตะเครา", "วัดเขาตะเครา", true],
  ["อุทยานประวัติศาสตร์พระนครคีรี (เขาวัง)", "อุทยานประวัติศาสตร์พระนครคีรี", true],
  ["วัดพระธาตุดอยสุเทพ", "วัดพระธาตุดอยสุเทพราชวรวิหาร", true],

  // เขตปกครอง ไม่ใช่ตัวสถานที่ — รูปจะเป็นภาพรวมของพื้นที่ ไม่ใช่ที่ที่ถาม
  ["หาดชะอำ", "อำเภอชะอำ", false],
  ["ปากทะเล", "ตำบลปากทะเล", false],
  ["บ้านแหลม", "อำเภอบ้านแหลม", false],

  // ชื่อซ้อนกันแต่คนละที่
  ["ตลาดสดวัดต้นสน (ตลาดบ้านแหลม)", "วัดต้นสน", false],
  ["ตลาดน้ำอัมพวา", "อัมพวา", false],

  // ไม่เกี่ยวกันเลย
  ["บางตะบูน", "หนังสือพิมพ์ปัญญาชน", false],
  ["จุดชมนาเกลือ Art of Salt", "เกลือ", false],

  // ขอบ
  ["", "อะไรก็ได้", false],
  ["ที่ไหนสักแห่ง", "", false],
];

console.log("ตัวกรองความเกี่ยวข้องของหน้าวิกิพีเดีย");
for (const [name, title, want] of CASES) {
  const got = isRelevantPage(title, name);
  check(
    `"${name || "(ว่าง)"}" ↔ "${title || "(ว่าง)"}" = ${want ? "รับ" : "ไม่รับ"}`,
    got === want,
    `ได้ ${got}`,
  );
}

console.log(`\nผ่าน ${pass} · ไม่ผ่าน ${fail}`);
process.exit(fail ? 1 : 0);
